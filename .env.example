# Canonical public site URL (used for sitemap, robots, and checkout URLs)
NEXT_PUBLIC_SITE_URL=https://admiralenergy.ai

# Stripe (required for checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Use a Stripe Price ID instead of inline line_items for HS-43
# STRIPE_PRICE_ID_SIDEKICK=price_...

# Internal commerce admin (required together; admin fails closed if any are absent)
COMMERCE_ADMIN_EMAIL=owner@example.com
# Generate with: npm run commerce:hash-password
COMMERCE_ADMIN_PASSWORD_HASH=$2b$12$replace_with_generated_bcrypt_hash
# Generate at least 32 random characters; never reuse the admin password
COMMERCE_SESSION_SECRET=replace_with_a_long_random_secret

# Optional display timezone for commerce dates
COMMERCE_TIMEZONE=America/New_York

# NETLIFY_DB_URL is managed automatically by Netlify Database. Do not commit it.
